generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  timezone     String   @default("UTC")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  gitConnections GitConnection[]

  @@map("users")
}

enum GitProviderType {
  GITHUB
  GITLAB
}

enum GitConnectionAuthType {
  GITHUB_APP
  OAUTH2
}

enum GitConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

model GitConnection {
  id                    String                @id @default(uuid()) @db.Uuid
  userId                String                @map("user_id") @db.Uuid
  provider              GitProviderType
  baseUrl               String                @map("base_url")
  providerUserId        String                @map("provider_user_id")
  providerUsername      String                @map("provider_username")
  authType              GitConnectionAuthType @map("auth_type")
  accessTokenEncrypted  String?               @map("access_token_encrypted")
  refreshTokenEncrypted String?               @map("refresh_token_encrypted")
  tokenExpiresAt        DateTime?             @map("token_expires_at")
  installationId        String?               @map("installation_id")
  status                GitConnectionStatus   @default(ACTIVE)
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, provider, baseUrl, providerUserId])
  @@map("git_connections")
}
