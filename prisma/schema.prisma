generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  timezone     String   @default("UTC")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  gitConnections GitConnection[]
  reports        Report[]

  @@map("users")
}

enum GitProviderType {
  GITHUB
  GITLAB
}

enum GitConnectionAuthType {
  GITHUB_APP
  OAUTH2
}

enum GitConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

model GitConnection {
  id                    String                @id @default(uuid()) @db.Uuid
  userId                String                @map("user_id") @db.Uuid
  provider              GitProviderType
  baseUrl               String                @map("base_url")
  providerUserId        String                @map("provider_user_id")
  providerUsername      String                @map("provider_username")
  authType              GitConnectionAuthType @map("auth_type")
  accessTokenEncrypted  String?               @map("access_token_encrypted")
  refreshTokenEncrypted String?               @map("refresh_token_encrypted")
  tokenExpiresAt        DateTime?             @map("token_expires_at")
  installationId        String?               @map("installation_id")
  status                GitConnectionStatus   @default(ACTIVE)
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories           Repository[]

  @@index([userId])
  @@unique([userId, provider, baseUrl, providerUserId])
  @@map("git_connections")
}

model Repository {
  id           String        @id @default(uuid()) @db.Uuid
  connectionId String        @map("connection_id") @db.Uuid
  externalId   String        @map("external_id")
  name         String
  fullName     String        @map("full_name")
  url          String?
  enabled      Boolean       @default(true)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  connection   GitConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([connectionId])
  @@map("repositories")
}

model Report {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             String       @map("user_id") @db.Uuid
  reportDate         DateTime     @map("report_date") @db.Date
  summary            String
  totalCommits       Int          @default(0) @map("total_commits")
  totalMergeRequests Int          @default(0) @map("total_merge_requests")
  totalReviews       Int          @default(0) @map("total_reviews")
  generatedAt        DateTime     @default(now()) @map("generated_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items              ReportItem[]

  @@unique([userId, reportDate])
  @@index([userId])
  @@map("reports")
}

model ReportItem {
  id             String   @id @default(uuid()) @db.Uuid
  reportId       String   @map("report_id") @db.Uuid
  provider       String
  repositoryName String   @map("repository_name")
  category       String
  title          String
  description    String
  activityCount  Int      @map("activity_count")
  sourceData     Json     @map("source_data")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  report         Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_items")
}
